#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
cmd=${1:-}; [[ -n $cmd ]] && shift || true
case "$cmd" in install) exec bash "$ROOT/scripts/workstation/install" "$@";; update) echo 'Update is a placeholder: pin and review a release before enabling self-update.'; exit 3;; doctor) exec bash "$ROOT/scripts/workstation/doctor";; cloud|security|ai|theme|skills|mcp|clean) echo "'$cmd' is planned and not implemented in v0.1.0."; exit 3;; -h|--help|help|'') echo 'Usage: workstation {install|update|doctor|cloud|security|ai|theme|skills|mcp|clean}';; *) echo "Unknown command: $cmd" >&2; exit 2;; esac
