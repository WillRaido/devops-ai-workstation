#!/usr/bin/env bash
set -u
echo 'DevOps AI Workstation v0.1.0 — experimental diagnostic'
printf 'OS: '; uname -srm
printf 'Package manager: '; if command -v brew >/dev/null; then echo brew; elif command -v apt-get >/dev/null; then echo apt; elif command -v dnf >/dev/null; then echo dnf; else echo unknown; fi
for c in zsh starship zoxide fzf rg jq eza bat atuin tmux; do if command -v "$c" >/dev/null 2>&1; then printf 'OK   %s
' "$c"; else printf 'MISS %s
' "$c"; fi; done
echo 'No credentials or cloud authentication are inspected.'
