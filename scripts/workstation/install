#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/common.sh"

profile=base
selected=()
install_ghostty=auto
apply_theme=auto
welcome_message=
welcome_style=
noninteractive=0
while (($#)); do
  case "$1" in
    --profile) profile=${2:?missing profile}; shift 2 ;;
    --with) IFS=',' read -r -a selected <<< "${2:?missing comma-separated tools}"; shift 2 ;;
    --ghostty) install_ghostty=yes; shift ;;
    --theme) apply_theme=${2:?missing theme}; shift 2 ;;
    --welcome) welcome_message=${2:?missing welcome text}; welcome_style=ascii; shift 2 ;;
    --welcome-style) welcome_style=${2:?missing welcome style}; shift 2 ;;
    --yes) noninteractive=1; shift ;;
    -h|--help) echo "Usage: bash ./install.sh [--profile base|full] [--with tool,tool] [--ghostty] [--theme Nord] [--welcome TEXT] [--welcome-style ascii|plain] [--yes]"; exit 0 ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
done
[[ $profile == base || $profile == full ]] || { echo 'Profile must be base or full' >&2; exit 2; }
[[ -z $welcome_style || $welcome_style == ascii || $welcome_style == plain ]] || { echo 'Welcome style must be ascii or plain.' >&2; exit 2; }
welcome_message=${welcome_message%%$'\n'*}

theme=''

base=(zsh starship zoxide fzf ripgrep jq eza bat atuin tmux figlet)
manager_name=$(manager)
command -v ghostty >/dev/null 2>&1 && ghostty_found=1 || ghostty_found=0
if [[ $manager_name == brew ]] && brew list --cask ghostty >/dev/null 2>&1; then ghostty_found=1; fi

ask_yes_no() {
  local prompt="$1" answer
  if ((noninteractive)); then return 1; fi
  while true; do
    read -r -p "$prompt [y/N] " answer
    case "$answer" in
      [yY]|[yY][eE][sS]|[sS]|[sS][iI]) return 0 ;;
      ''|[nN]|[nN][oO]) return 1 ;;
      *) printf '  Responde y/n (o s/n). Para un mensaje personalizado, primero responde y.\n' ;;
    esac
  done
}

menu_choose() {
  local title="$1" mode="$2" key sequence i mark
  local cursor=0
  menu_result=()
  local -a menu_toggles=()
  for ((i=0; i<${#menu_options[@]}; i++)); do menu_toggles+=(0); done
  while true; do
    printf '\033[H\033[2J\n  %s\n' "$title"
    if [[ $mode == multi ]]; then printf '  ↑/↓ mover · Espacio marcar · a todas · c limpiar · Enter continuar\n\n'
    else printf '  ↑/↓ mover · Enter elegir\n\n'; fi
    for ((i=0; i<${#menu_options[@]}; i++)); do
      if [[ $mode == multi ]]; then [[ ${menu_toggles[i]} == 1 ]] && mark='x' || mark=' '
      else [[ $i == "$cursor" ]] && mark='›' || mark=' '; fi
      printf '  %s [%s] %s\n' "$([[ $i == "$cursor" ]] && printf '>' || printf ' ')" "$mark" "${menu_options[i]}"
    done
    if [[ $mode == multi ]]; then
      local count=0
      for mark in "${menu_toggles[@]}"; do [[ $mark == 1 ]] && ((count+=1)); done
      printf '\n  %d herramienta(s) seleccionada(s)\n' "$count"
    fi
    IFS= read -r -s -n1 key
    if [[ $key == $'\033' ]]; then
      sequence=''; IFS= read -r -s -n2 -t 1 sequence || true
      case "$sequence" in '[A'|'OA') ((cursor>0)) && ((cursor-=1)) ;; '[B'|'OB') ((cursor<${#menu_options[@]}-1)) && ((cursor+=1)) ;; esac
    elif [[ -z $key || $key == $'\n' || $key == $'\r' ]]; then
      if [[ $mode == multi ]]; then
        for ((i=0; i<${#menu_options[@]}; i++)); do [[ ${menu_toggles[i]} == 1 ]] && menu_result+=("${menu_options[i]}"); done
        ((${#menu_result[@]})) || menu_result=('__NONE__')
      else menu_result=("${menu_options[cursor]}"); fi
      return 0
    elif [[ $mode == multi && $key == ' ' ]]; then
      [[ ${menu_toggles[cursor]} == 1 ]] && menu_toggles[cursor]=0 || menu_toggles[cursor]=1
    elif [[ $mode == multi && $key == [aA] ]]; then
      for ((i=0; i<${#menu_toggles[@]}; i++)); do menu_toggles[i]=1; done
    elif [[ $mode == multi && $key == [cC] ]]; then
      for ((i=0; i<${#menu_toggles[@]}; i++)); do menu_toggles[i]=0; done
    fi
  done
}

if [[ -t 0 && -t 1 && $noninteractive -eq 0 ]]; then
  clear 2>/dev/null || true
  printf '\n\033[1;36m  DEVOPS AI WORKSTATION\033[0m  ·  v0.1.0 experimental\n'
  printf '  Prepararé un plan para este equipo. No modificaré configuraciones existentes sin preguntarte.\n\n'
  printf '  Sistema: %s\n  Gestor:  %s\n  Ghostty: %s\n\n' "$(uname -srm)" "$manager_name" "$([[ $ghostty_found -eq 1 ]] && echo 'detectado' || echo 'no detectado')"
  printf '  Paso 1/4 · Herramientas de terminal\n'
  if ((${#selected[@]} == 0)); then
    menu_options=("${base[@]}")
    if [[ ${TERM:-dumb} != dumb ]]; then
      menu_choose 'Elige las herramientas base que quieres instalar' multi
      selected=("${menu_result[@]}")
      [[ ${selected[0]:-} == __NONE__ ]] && selected=()
    else
      printf '  Escribe los nombres separados por coma, o Enter para omitir.\n  Opciones: %s\n' "${base[*]}"
      read -r -p '  Selección: ' choice
      if [[ -n $choice ]]; then IFS=',' read -r -a selected <<< "$choice"; fi
    fi
  fi
  printf '\n  Paso 2/4 · Ghostty\n'
  if [[ $ghostty_found -eq 0 && $manager_name == brew ]] && ask_yes_no '  ¿Instalo Ghostty también?' ; then install_ghostty=yes; fi
  printf '\n  Paso 3/4 · Tema\n'
  if [[ $ghostty_found -eq 1 || $install_ghostty == yes ]]; then
    if [[ ${TERM:-dumb} != dumb ]]; then
      menu_options=('Dejar el tema actual' Nord Dracula 'Catppuccin Mocha' 'Gruvbox Dark')
      menu_choose 'Elige un tema para Ghostty' single
      theme_choice=${menu_result[0]}
      [[ $theme_choice == 'Dejar el tema actual' ]] || apply_theme=$theme_choice
    else
      printf '  Temas: Nord, Dracula, Catppuccin Mocha, Gruvbox Dark\n'
      read -r -p '  Tema de Ghostty (Enter para dejarlo igual): ' theme_choice
      [[ -n $theme_choice ]] && apply_theme=$theme_choice
    fi
  fi
  printf '\n  Paso 4/4 · Mensaje de bienvenida · Zsh / Ghostty\n'
  if [[ -n $welcome_message ]]; then
    printf '  Mensaje recibido por argumento: %s\n' "$welcome_message"
  elif ask_yes_no '  ¿Quieres un mensaje al abrir una terminal Zsh?' ; then
    read -r -p '  Texto (ejemplo WillDevOps, Enter = DevOps Workstation): ' welcome_message
    [[ -n $welcome_message ]] || welcome_message='DevOps Workstation'
    printf '  Estilo: 1) ASCII grande  2) sencillo\n'
    read -r -p '  Elige 1 o 2 [1]: ' style_choice
    if [[ $style_choice == 2 ]]; then welcome_style=plain; else welcome_style=ascii; fi
  fi
  printf '\n  Se respetarán los archivos de configuración existentes.\n'
  if [[ -n $welcome_message && -z $welcome_style ]]; then welcome_style=ascii; fi
  if [[ -n $welcome_style && $welcome_style != ascii && $welcome_style != plain ]]; then echo 'Estilo de bienvenida debe ser ascii o plain.' >&2; exit 2; fi
  if ! ask_yes_no '  Escribe y para aplicar el plan, o n para cancelar. ¿Aplico este plan?' ; then echo 'Cancelado; no hice cambios.'; exit 0; fi
else
  if ((${#selected[@]} == 0)) && [[ $noninteractive -eq 1 ]]; then selected=("${base[@]}"); fi
fi

if [[ $apply_theme != auto && $apply_theme != '' ]]; then
  case "$apply_theme" in
    Nord|nord) theme='Nord' ;;
    Dracula|dracula) theme='Dracula' ;;
    'Catppuccin Mocha'|catppuccin-mocha|catppuccin) theme='Catppuccin Mocha' ;;
    'Gruvbox Dark'|gruvbox-dark|gruvbox) theme='Gruvbox Dark' ;;
    *) echo "Tema no reconocido: $apply_theme" >&2; exit 2 ;;
  esac
fi

if ((${#selected[@]} > 0)); then
  for tool in "${selected[@]}"; do
    valid=0
    for candidate in "${base[@]}"; do [[ $tool == "$candidate" ]] && valid=1; done
    if [[ $valid -ne 1 ]]; then echo "Herramienta no reconocida para base: $tool" >&2; exit 2; fi
  done
fi

printf 'Plan: perfil %s · gestor %s · herramientas seleccionadas: %s\n' "$profile" "$manager_name" "${selected[*]:-(ninguna)}"
if [[ $manager_name == brew ]]; then
  if ((${#selected[@]} > 0)); then
    for package in "${selected[@]}"; do
      if brew list --versions "$package" >/dev/null 2>&1; then printf 'Ya instalada: %s (se conserva)\n' "$package"
      else printf 'Instalando: %s\n' "$package"; brew install "$package"; fi
    done
  fi
  if [[ $install_ghostty == yes && $ghostty_found -eq 0 ]]; then
    if brew list --cask ghostty >/dev/null 2>&1; then echo 'Ghostty ya está instalado; se conserva.'
    else brew install --cask ghostty; ghostty_found=1; fi
  fi
elif [[ $manager_name == apt ]]; then
  echo 'Linux/apt detectado. No instalo paquetes automáticamente ni invoco sudo; instala los seleccionados con tu flujo de paquetes preferido.'
elif [[ $manager_name == dnf || $manager_name == pacman ]]; then
  echo "Detecté $manager_name. La integración de instalación todavía está pendiente; no hice cambios de paquetes."
else
  echo 'No encontré un gestor compatible; no instalé paquetes.'
fi

config_dir="$HOME/.config"
mkdir -p "$config_dir"
for source_file in "$ROOT/config/starship.toml" "$ROOT/config/zsh/.zshrc"; do
  if [[ $source_file == */.zshrc ]]; then destination="$HOME/.zshrc"; else destination="$config_dir/starship.toml"; fi
  if [[ ! -e $destination ]]; then cp "$source_file" "$destination"; printf 'Añadida configuración de muestra: %s\n' "$destination"
  else printf 'Configuración existente preservada: %s\n' "$destination"; fi
done

if [[ -n $welcome_message ]]; then
  welcome_dir="$config_dir/workstation"
  mkdir -p "$welcome_dir"
  cp "$ROOT/config/zsh/workstation-welcome.zsh" "$welcome_dir/welcome.zsh"
  printf '%s\n' "$welcome_message" > "$welcome_dir/welcome.txt"
  printf '%s\n' "$welcome_style" > "$welcome_dir/welcome-style.txt"
  zshrc="$HOME/.zshrc"
  hook_line='welcome_hook="${XDG_CONFIG_HOME:-$HOME/.config}/workstation/welcome.zsh"; [[ -r "$welcome_hook" ]] && source "$welcome_hook"; unset welcome_hook'
  if [[ ! -e $zshrc ]]; then
    cp "$ROOT/config/zsh/.zshrc" "$zshrc"
  elif ! grep -Fq 'workstation/welcome.zsh' "$zshrc"; then
    backup="$zshrc.backup.$(date +%Y%m%d%H%M%S)"
    cp -p "$zshrc" "$backup"
    printf '\n# DevOps AI Workstation welcome message\n%s\n' "$hook_line" >> "$zshrc"
    printf 'Added welcome hook; Zsh backup: %s\n' "$backup"
  fi
  printf 'Mensaje de bienvenida configurado: %s (%s)\n' "$welcome_message" "$welcome_style"
fi

if [[ -n $theme ]]; then
  if [[ $ghostty_found -eq 1 || $install_ghostty == yes ]]; then
    ghostty_dir="$config_dir/ghostty"
    mkdir -p "$ghostty_dir"
    if [[ -e "$ghostty_dir/config.ghostty" ]]; then ghostty_config="$ghostty_dir/config.ghostty"
    elif [[ -e "$ghostty_dir/config" ]]; then ghostty_config="$ghostty_dir/config"
    else ghostty_config="$ghostty_dir/config.ghostty"; fi
    if [[ -e $ghostty_config ]]; then
      backup="$ghostty_config.backup.$(date +%Y%m%d%H%M%S)"
      cp -p "$ghostty_config" "$backup"
      tmp="$ghostty_config.tmp.$$"
      if grep -Eq '^[[:space:]]*theme[[:space:]]*=' "$ghostty_config"; then
        awk -v value="$theme" '/^[[:space:]]*theme[[:space:]]*=/ {$0="theme = " value} {print}' "$ghostty_config" > "$tmp"
      else
        cat "$ghostty_config" > "$tmp"
        printf '\n# Added by DevOps AI Workstation\ntheme = %s\n' "$theme" >> "$tmp"
      fi
      mv "$tmp" "$ghostty_config"
      printf 'Tema aplicado a Ghostty; respaldo: %s\n' "$backup"
    else
      printf 'theme = %s\n' "$theme" > "$ghostty_config"
      printf 'Tema de Ghostty configurado: %s\n' "$theme"
    fi
  else
    echo 'Ghostty no está instalado; no apliqué un tema.'
  fi
fi

if [[ $profile == full ]]; then
  printf '\nCloud, seguridad y AI están catalogados, pero su instalación todavía está pendiente. No instalé herramientas de esos perfiles.\n'
fi
printf '\nListo. Diagnóstico: ./scripts/workstation/workstation doctor\n'
